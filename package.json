{
  "name": "@corridor/verify",
  "version": "0.1.0",
  "description": "Client SDK for Corridor — read a corridor policy, build an eligibility witness, and check payout clearance on Stellar.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test src/*.test.ts",
    "test:live": "CORRIDOR_LIVE_TESTS=1 node --import tsx --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"examples/**/*.ts\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"examples/**/*.ts\"",
    "gen-fixture": "tsx scripts/gen-fixture.ts",
    "docs": "typedoc"
  },
  "keywords": [
    "stellar",
    "soroban",
    "midnight",
    "zero-knowledge",
    "kyc",
    "privacy"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sconce-Labs/corridor-sdk"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@stellar/stellar-sdk": "^13.0.0",
    "@zkpassport/poseidon2": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.1",
    "typedoc": "^0.26.0",
    "typescript": "^5.6.0"
  }
}
